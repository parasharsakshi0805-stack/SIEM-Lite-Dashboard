# Copy this file to "backend/.env", then change the values.
# NEVER commit the real .env file. NEVER put real secrets in this example file.

# Generate EACH of these with:  python -c "import secrets; print(secrets.token_hex(32))"
# (run it twice -- the two values must be different)
SECRET_KEY=CHANGE_ME
AGENT_API_KEY=CHANGE_ME

# Only used when you run the backend WITHOUT Docker.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/siem_lite
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:5173

# Keep "false" for local http testing. Set "true" once you use HTTPS.
COOKIE_SECURE=false
