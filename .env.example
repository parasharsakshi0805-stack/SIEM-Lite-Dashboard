# Copy this file to ".env" in the project root, then change the values.
# NEVER commit the real .env file. NEVER put real secrets in this example file.

POSTGRES_USER=postgres
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=siem_lite

# "postgres" is the database container's name.
# The password here MUST match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/siem_lite

CORS_ORIGINS=http://localhost:5173,http://localhost
